<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!--
      OPCDAAuto.dll, the OPC DA automation wrapper, is an in-process COM server and is
      normally registered 32-bit only. A 64-bit process cannot load it and reports
      "class not registered". Sites with the x64 Core Components can remove this.
    -->
    <PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <!-- OPC DA Automation 2.0 interop, as the plant's other services reference it. -->
    <Reference Include="Interop.OPCAutomation">
      <HintPath>..\..\lib\Interop.OPCAutomation.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.10" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <None Update="config_AB.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Update="trenchSize.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Update="screens\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
