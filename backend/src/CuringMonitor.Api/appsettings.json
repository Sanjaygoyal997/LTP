{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AllowedOrigins": [
    "http://localhost:5173"
  ],
  "Plant": {
    "Title": "Equipment Status",
    "LayoutFile": "config_AB.txt",
    "PollInterval": "00:00:02",
    "Provider": "simulated",
    "Shifts": {
      "AStartHour": 7,
      "BStartHour": 15,
      "CStartHour": 23
    },
    "Opc": {
      "ServerName": "Kepware.KEPServerEX.V6",
      "Node": "",
      "GroupName": "CuringMonitor",
      "UpdateRate": "00:00:01",
      "ReconnectDelay": "00:00:05",
      "AddItemsBatchSize": 500,
      "ReadBatchSize": 500
    },
    "ScreensDirectory": "screens",
    "WatchScreens": true,
    "WatchConfiguration": true,
    "GroupLabelFormat": "Trench {0}",
    "RunThreshold": 1.0,
    "Production": {
      "Provider": "simulated",
      "ConnectionString": "Server=.;Database=SMARTMESBTP;Trusted_Connection=True;TrustServerCertificate=True",
      "RefreshInterval": "00:00:30",
      "ByWorkCentreQuery": "SELECT wcID, SUM(quantity) FROM dbo.CuringProduction WHERE dtandTime >= @from GROUP BY wcID",
      "ByShiftQuery": "SELECT shift, SUM(quantity) FROM dbo.CuringProduction WHERE dtandTime >= @from GROUP BY shift"
    },
    "Signals": {
      "RunCheck": "runCheck",
      "Alarm": "alarm",
      "Recipe": "recipe"
    }
  }
}