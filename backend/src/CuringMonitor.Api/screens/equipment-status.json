{
  "id": "equipment-status",
  "title": "Equipment Status",
  "theme": {
    "floor": "#d4d4d4",
    "panel": "#000000",
    "chrome": "#111111",
    "accent": "#00a2e8",
    "status": {
      "running": "#00e05a",
      "stopped": "#ffe400",
      "alarm": "#ff1e1e",
      "noCommunication": "#9a9a9a"
    },
    "tile": {
      "minWidth": 44,
      "maxWidth": 112
    },
    "alarmPulse": true
  },
  "widgets": [
    {
      "type": "tile-grid",
      "region": "floor",
      "showGroupLabel": true,
      "showGroupShiftCount": true,
      "source": {
        "groupBy": "asset.group",
        "orderBy": "asset.position",
        "wrap": "auto"
      },
      "tile": {
        "header": "asset.label",
        "sub": "signal.recipe",
        "value": "signal.count",
        "colour": "status",
        "tooltip": [
          {
            "label": "Equipment",
            "field": "asset.label"
          },
          {
            "label": "Group",
            "field": "asset.group"
          },
          {
            "label": "Status",
            "field": "status.label"
          },
          {
            "label": "Recipe",
            "field": "signal.recipe"
          },
          {
            "label": "Cures this shift",
            "field": "signal.count"
          },
          {
            "label": "Reading",
            "field": "signal.runCheck"
          }
        ]
      }
    },
    {
      "type": "kpi-panel",
      "region": "footer",
      "title": "Production",
      "orientation": "columns",
      "items": [
        {
          "label": "A",
          "field": "production.a"
        },
        {
          "label": "B",
          "field": "production.b"
        },
        {
          "label": "C",
          "field": "production.c"
        },
        {
          "label": "Total",
          "field": "production.total"
        }
      ]
    },
    {
      "type": "kpi-panel",
      "region": "footer",
      "title": "Equipment",
      "orientation": "rows",
      "items": [
        {
          "label": "Total Curing Running",
          "field": "totals.running"
        },
        {
          "label": "Total Curing Stop",
          "field": "totals.stopped"
        },
        {
          "label": "Total Not Communicating",
          "field": "totals.noCommunication"
        }
      ]
    },
    {
      "type": "legend",
      "region": "footer",
      "title": "Legends",
      "order": [
        "noCommunication",
        "running",
        "stopped",
        "alarm"
      ]
    }
  ]
}